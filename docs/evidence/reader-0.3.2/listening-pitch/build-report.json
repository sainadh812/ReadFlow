  "captionCount": 19,
  "captions": {
    "cueCount": 19,
    "cues": [
      {
        "start": 0.8099999999999998,
        "end": 2.54,
        "text": "Your reading list keeps growing.",
        "kind": "explanatory-narration"
      },
      {
        "start": 3.0100000000000002,
        "end": 6.32,
        "text": "But finding time to sit down with it isn't always easy.",
        "kind": "explanatory-narration"
      },
      {
        "start": 7.09,
        "end": 10.919999999999998,
        "text": "Read Assist lets you listen to the documents you've been meaning to read.",
        "kind": "explanatory-narration"
      },
      {
        "start": 12.003333333333334,
        "end": 13.973333333333333,
        "text": "Open a PDF and press play.",
        "kind": "explanatory-narration"
      },
      {
        "start": 14.6,
        "end": 17.6,
        "text": "A page gives us time to pause,\nnotice a detail,",
        "kind": "recorded-app-speech",
        "vttSettings": "line:10%"
      },
      {
        "start": 17.6,
        "end": 19.700000000000003,
        "text": "and follow an idea at our own pace.",
        "kind": "recorded-app-speech",
        "vttSettings": "line:10%"
      },
      {
        "start": 19.700000000000003,
        "end": 22.43333333333333,
        "text": "Each sentence adds something new\nto the picture.",
        "kind": "recorded-app-speech",
        "vttSettings": "line:10%"
      },
      {
        "start": 22.496666666666666,
        "end": 27.109166666666667,
        "text": "Follow the text, keep the original page on screen, or switch apps and let the",
        "kind": "explanatory-narration"
      },
      {
        "start": 27.109166666666667,
        "end": 29.986666666666665,
        "text": "reading continue while you get on with your day.",
        "kind": "explanatory-narration"
      },
      {
        "start": 31.536666666666665,
        "end": 35.026666666666664,
        "text": "When a word stops you, its meaning is right there in the reader.",
        "kind": "explanatory-narration"
      },
      {
        "start": 35.75666666666666,
        "end": 39.56466666666667,
        "text": "And when you're ready to settle in, adjust the brightness and warm the page",
        "kind": "explanatory-narration"
      },
      {
        "start": 39.56466666666667,
        "end": 41.30666666666666,
        "text": "until it feels right for you.",
        "kind": "explanatory-narration"
      },
      {
        "start": 42.83666666666667,
        "end": 46.906666666666666,
        "text": "Download the voice and dictionary packs once for offline listening and",
        "kind": "explanatory-narration"
      },
      {
        "start": 46.906666666666666,
        "end": 47.38666666666667,
        "text": "definitions.",
        "kind": "explanatory-narration"
      },
      {
        "start": 48.096666666666664,
        "end": 48.78666666666666,
        "text": "No account.",
        "kind": "explanatory-narration"
      },
      {
        "start": 49.31666666666666,
        "end": 49.906666666666666,
        "text": "No ads.",
        "kind": "explanatory-narration"
      },
      {
        "start": 50.45666666666666,
        "end": 51.22666666666666,
        "text": "Read Assist.",
        "kind": "explanatory-narration"
      },
      {
        "start": 51.71666666666667,
        "end": 52.66666666666667,
        "text": "Read when you can.",
        "kind": "explanatory-narration"
      },
      {
