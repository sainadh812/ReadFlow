  "captions": {
    "cueCount": 16,
    "alignment": "Approximate CTC sentence bounds with proportional splits for long captions; not manual word alignment.",
    "cues": [
      {
        "start": 0.8099999999999998,
        "end": 2.54,
        "text": "Your reading list keeps growing."
      },
      {
        "start": 3.0100000000000002,
        "end": 6.32,
        "text": "But finding time to sit down with it isn't always easy."
      },
      {
        "start": 7.09,
        "end": 10.919999999999998,
        "text": "Read Assist lets you listen to the documents you've been meaning to read."
      },
      {
        "start": 12.003333333333334,
        "end": 13.973333333333333,
        "text": "Open a PDF and press play."
      },
      {
        "start": 14.663333333333334,
        "end": 19.275833333333335,
        "text": "Follow the text, keep the original page on screen, or switch apps and let the"
      },
      {
        "start": 19.275833333333335,
        "end": 22.153333333333332,
        "text": "reading continue while you get on with your day."
      },
      {
        "start": 23.703333333333333,
        "end": 27.19333333333333,
        "text": "When a word stops you, its meaning is right there in the reader."
      },
      {
        "start": 27.923333333333332,
        "end": 31.731333333333332,
        "text": "And when you're ready to settle in, adjust the brightness and warm the page"
      },
      {
        "start": 31.731333333333332,
        "end": 33.47333333333333,
        "text": "until it feels right for you."
      },
      {
        "start": 35.00333333333334,
        "end": 39.07333333333334,
        "text": "Download the voice and dictionary packs once for offline listening and"
      },
      {
        "start": 39.07333333333334,
        "end": 39.553333333333335,
        "text": "definitions."
      },
      {
        "start": 40.263333333333335,
        "end": 40.95333333333333,
        "text": "No account."
      },
      {
        "start": 41.483333333333334,
        "end": 42.07333333333333,
        "text": "No ads."
      },
      {
        "start": 42.623333333333335,
        "end": 43.39333333333333,
        "text": "Read Assist."
      },
      {
        "start": 43.88333333333333,
        "end": 44.833333333333336,
        "text": "Read when you can."
      },
      {
        "start": 45.403333333333336,
        "end": 46.413333333333334,
        "text": "Listen when you like."
      }
    ]
  },
